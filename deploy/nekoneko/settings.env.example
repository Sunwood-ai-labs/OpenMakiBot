# Optional: copy to deploy/podman/.env.nekoneko before setup and edit literal values.
# Blank data/socket values are resolved inside the selected Podman machine.
OMB_PODMAN_MACHINE=openmausbot
COMPOSE_PROJECT_NAME=nekoneko-article
OMB_IMAGE_TAG=nekoneko-article
OMB_DATA_ROOT=
PODMAN_SOCKET=
OMB_PORT=31799
OMB_WEBHOOK_PORT=31800
OMB_HTTP_PORT=31880
OMB_PUBLIC_URL=
OMB_HTTPS_HOST=https-disabled.invalid
ENGINES=@anthropic-ai/claude-code@2.1.263
OMB_GLM_MODEL=glm-5.3
OMB_ANTHROPIC_BASE_URL=https://api.z.ai/api/anthropic
OMB_TURN_TIMEOUT_MINUTES=20
